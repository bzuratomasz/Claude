<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET Framework 4.0 is the lowest common denominator: it can be installed on Windows 7 SP1
    and every 4.x runtime (4.8.1 ships with Windows 11) runs it in-place.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net40</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LazyTurtle</AssemblyName>
    <RootNamespace>LazyTurtle</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>4.0.0</Version>
    <Product>Lazy Turtle</Product>
    <AssemblyTitle>Lazy Turtle</AssemblyTitle>
    <Company>LazyTurtle</Company>
    <Copyright>Copyright © 2026</Copyright>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Speech" />
  </ItemGroup>

</Project>
