<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SearchCar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SearchCar.App.ViewModels"
    xmlns:models="using:SearchCar.Core.Models"
    Title="SearchCar - wyszukiwarka aut">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- ============ Search criteria ============ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16" Spacing="12">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Szukaj auta" />

                <ComboBox Header="Marka" PlaceholderText="Dowolna marka" IsEditable="True" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.MakeOptions}"
                          Text="{x:Bind ViewModel.Make, Mode=TwoWay}" />

                <ComboBox Header="Model" PlaceholderText="Dowolny model" IsEditable="True" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.ModelOptions}"
                          Text="{x:Bind ViewModel.Model, Mode=TwoWay}" />

                <StackPanel Spacing="0" Margin="0,-6,0,0">
                    <TextBlock Text="{x:Bind ViewModel.CatalogInfo, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <HyperlinkButton Content="Aktualizuj marki i modele z otomoto.pl" Padding="0,2"
                                     FontSize="12" Click="RefreshCatalog_Click" />
                </StackPanel>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox Header="Rok od" PlaceholderText="dowolny" Minimum="1950" Maximum="2100"
                               SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.YearFrom, Mode=TwoWay}" />
                    <NumberBox Grid.Column="1" Header="Rok do" PlaceholderText="dowolny" Minimum="1950" Maximum="2100"
                               SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.YearTo, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox Header="Przebieg od (km)" PlaceholderText="dowolny" Minimum="0" SmallChange="10000" LargeChange="50000"
                               Value="{x:Bind ViewModel.MileageFrom, Mode=TwoWay}" />
                    <NumberBox Grid.Column="1" Header="Przebieg do (km)" PlaceholderText="dowolny" Minimum="0" SmallChange="10000" LargeChange="50000"
                               Value="{x:Bind ViewModel.MileageTo, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox Header="Cena od (PLN)" PlaceholderText="dowolna" Minimum="0"
                               Value="{x:Bind ViewModel.PriceFrom, Mode=TwoWay}" />
                    <NumberBox Grid.Column="1" Header="Cena do (PLN)" PlaceholderText="dowolna" Minimum="0"
                               Value="{x:Bind ViewModel.PriceTo, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Header="Paliwo" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.FuelOptions}"
                              SelectedIndex="{x:Bind ViewModel.FuelIndex, Mode=TwoWay}" />
                    <ComboBox Grid.Column="1" Header="Skrzynia biegów" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.GearboxOptions}"
                              SelectedIndex="{x:Bind ViewModel.GearboxIndex, Mode=TwoWay}" />
                </Grid>

                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Lokalizacja" Margin="0,8,0,0" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="Miejscowość lub adres" KeyDown="PlaceQuery_KeyDown"
                             Text="{x:Bind ViewModel.PlaceQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Click="FindPlace_Click" ToolTipService.ToolTip="Znajdź miejsce">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                    </Button>
                </Grid>

                <TextBlock Text="{x:Bind ViewModel.LocationText, Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Wskazówka: kliknij mapę lub przeciągnij pinezkę, aby zmienić lokalizację." TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <StackPanel Spacing="0">
                    <TextBlock Text="{x:Bind ViewModel.RadiusText, Mode=OneWay}" />
                    <Slider Minimum="5" Maximum="{x:Bind ViewModel.MaxRadiusKm}" StepFrequency="5" SmallChange="5" LargeChange="25"
                            Value="{x:Bind ViewModel.RadiusKm, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Źródła" Margin="0,8,0,0" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Sources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourceOptionViewModel">
                            <CheckBox IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind Hint}">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Label}" />
                                    <TextBlock Text="{x:Bind Hint}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="OLX.pl blokuje automatyczne wyszukiwanie - po wyszukaniu pojawi się link do tego samego wyszukiwania na OLX." />
                <NumberBox Header="Liczba stron wyników z każdego serwisu" Minimum="1" Maximum="10"
                           SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.MaxPages, Mode=TwoWay}" />

                <Button Content="Szukaj" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                        Click="Search_Click" />
                <Button Content="Wyczyść filtry" HorizontalAlignment="Stretch" Click="Reset_Click" />

                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.SearchNotes, Mode=OneWay}" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.HasSearchNotes, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Visibility="{x:Bind ViewModel.HasSearchLinks, Mode=OneWay}">
                    <TextBlock Text="Otwórz to wyszukiwanie w przeglądarce:" Style="{StaticResource CaptionTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SearchLinks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SourceLink">
                                <HyperlinkButton Content="{x:Bind Label}" NavigateUri="{x:Bind Url}" Padding="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="4" Margin="0,8,0,0">
                    <TextBlock Text="Legenda statusu VIN" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="10" Height="10" Fill="#4CAF50" /><TextBlock Text="Zweryfikowany" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="10" Height="10" Fill="#F0A020" /><TextBlock Text="OK z uwagami" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="10" Height="10" Fill="#EF5350" /><TextBlock Text="Podejrzany" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="10" Height="10" Fill="#E91E63" /><TextBlock Text="Nieprawidłowy" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="10" Height="10" Fill="#AB47BC" /><TextBlock Text="VIN ukryty w serwisie (odkryj go tam)" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="10" Height="10" Fill="#9E9E9E" /><TextBlock Text="Brak VIN" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="10" Height="10" Fill="#42A5F5" /><TextBlock Text="W trakcie sprawdzania" /></StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Map + results ============ -->
        <Grid Grid.Column="1" Padding="0,8,0,8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <WebView2 x:Name="MapView" />
            </Border>

            <TextBlock Grid.Row="1" Style="{StaticResource SubtitleTextBlockStyle}"
                       Text="{x:Bind ViewModel.ResultsHeader, Mode=OneWay}" />

            <ListView x:Name="ResultsList" Grid.Row="2" SelectionMode="Single"
                      ItemsSource="{x:Bind ViewModel.Results}"
                      SelectionChanged="ResultsList_SelectionChanged"
                      DoubleTapped="ResultsList_DoubleTapped"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultItemViewModel">
                        <Grid Padding="0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                                     Fill="{x:Bind StatusBrush, Mode=OneWay}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{x:Bind StatusBrush, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                <TextBlock Text="{x:Bind PriceText}" HorizontalAlignment="Right"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind DistanceText, Mode=OneWay}" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ============ VIN report ============ -->
        <Border Grid.Column="2" Margin="8" CornerRadius="8" Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <TextBlock Text="Wybierz auto z listy wyników lub z mapy, aby zobaczyć raport VIN."
                           TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.HasNoSelection, Mode=OneWay}" />

                <ScrollViewer Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="0,0,12,0">
                        <TextBlock Text="Raport VIN" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedResult.Headline, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                            <Run Text="{x:Bind ViewModel.SelectedResult.Title, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{x:Bind ViewModel.SelectedResult.PriceText, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{x:Bind ViewModel.SelectedResult.Subtitle, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{x:Bind ViewModel.SelectedResult.PlaceText, Mode=OneWay}" />
                        </TextBlock>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="4" Padding="10,4"
                                    Background="{x:Bind ViewModel.SelectedResult.StatusBrush, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.SelectedResult.StatusText, Mode=OneWay}" Foreground="White"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OpenOffer_Click"
                                    IsEnabled="{x:Bind ViewModel.SelectedResult.HasUrl, Mode=OneWay}"
                                    ToolTipService.ToolTip="Otwórz ogłoszenie w przeglądarce">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8A7;" FontSize="14" /><TextBlock Text="Otwórz ogłoszenie" /></StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.SelectedResult.VinText, Mode=OneWay}" FontFamily="Consolas" FontSize="16"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedResult.Summary, Mode=OneWay}" TextWrapping="Wrap" />

                        <TextBlock Text="Sprawdź inny VIN (np. odkryty na stronie ogłoszenia)" TextWrapping="Wrap" Margin="0,0,0,-8" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox PlaceholderText="17-znakowy VIN"
                                     FontFamily="Consolas" MaxLength="20" CharacterCasing="Upper" KeyDown="ManualVin_KeyDown"
                                     Text="{x:Bind ViewModel.SelectedResult.ManualVin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Sprawdź" Click="VerifyManualVin_Click" />
                        </Grid>

                        <TextBlock Text="Sprawdzenia" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedResult.Checks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CheckItemViewModel">
                                    <Grid ColumnSpacing="10" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind Brush}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.SelectedResult.HasDecodedFields, Mode=OneWay}">
                            <TextBlock Text="Dane z dekodera" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedResult.DecodedFields, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DetailItemViewModel">
                                        <Grid ColumnSpacing="8" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Key}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Click="CopyReport_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="14" /><TextBlock Text="Kopiuj" /></StackPanel>
                            </Button>
                            <Button Click="SaveReport_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="14" /><TextBlock Text="Zapisz…" /></StackPanel>
                            </Button>
                            <Button Click="Reverify_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Sprawdź ponownie" /></StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="ReportActionMessage" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
